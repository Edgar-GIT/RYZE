# RYZE edge proxy. Copy to /opt/ryze/edge/Caddyfile on the VPS.
#
# Traffic path: browser -> Cloudflare (proxy, TLS) -> this Caddy (TLS with the
# Cloudflare Origin Certificate, Cloudflare SSL mode "Full (strict)") -> API.
#
# Replace ryzecoaching.com if the domain changes. Keep the Cloudflare IP
# ranges up to date from https://www.cloudflare.com/ips/ (checked 2026-11-27).

{
	# Caddy's own admin API stays off; nothing manages it remotely.
	admin off
	servers {
		# Only Cloudflare may tell us the visitor's address. Caddy then passes
		# that address to the API in X-Forwarded-For, and the API trusts only
		# this proxy (RATE_LIMIT_TRUSTED_PROXIES), so rate limits apply per
		# visitor instead of per Cloudflare server.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(api_common) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	encode zstd gzip
	# Evidence documents (25 MiB) and the contact form attachment.
	request_body {
		max_size 26MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output stdout
		format json
	}
}

api.ryzecoaching.com {
	import api_common
	reverse_proxy ryze-production-backend:8080 {
		health_uri /api/v1/health
		health_interval 30s
	}
}

api-staging.ryzecoaching.com {
	import api_common
	# Staging is not for the public: keep it out of search engines.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy ryze-staging-backend:8080
}

# Anything else (bare IP, unknown names) is refused.
:443 {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	respond 404
}

:80 {
	respond 404
}
