DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ryze
DB_USER=ryze_admin
DB_PASSWORD=
# Root password for the containerised database only (docker-compose.yml). Not
# used when DB_HOST points at a database you administer yourself.
DB_ROOT_PASSWORD=

# JWT signing secret. Required; must be at least 32 characters.
# Generate one locally, never commit a real value:  openssl rand -hex 32
JWT_SECRET=
# Access token lifetime (Go duration syntax), defaults to 15m when unset.
JWT_ACCESS_TOKEN_TTL=15m
# Auth cookie Secure flag. True in production (HTTPS). Set to false only for
# local HTTP development.
COOKIE_SECURE=true
# Comma-separated origins allowed to call the API with credentials. Defaults to
# the Vite dev server origins (localhost:5173) when unset.
CORS_ALLOWED_ORIGINS=

# HTTP server safety (optional). Every value falls back to the default shown
# when unset; an invalid value fails backend startup. Bodies larger than
# SERVER_MAX_BODY_BYTES are rejected with 413 REQUEST_ENTITY_TOO_LARGE.
# SERVER_READ_HEADER_TIMEOUT=10s
# SERVER_READ_TIMEOUT=30s
# SERVER_WRITE_TIMEOUT=60s
# SERVER_IDLE_TIMEOUT=120s
# SERVER_SHUTDOWN_TIMEOUT=20s
# SERVER_MAX_BODY_BYTES=1048576

# Authentication rate limiting (optional). Enabled by default; the credential
# and account endpoints (register, login, admin login/verify, change-password,
# delete-account) are limited per client IP and per account identifier.
# RATE_LIMIT_ENABLED=false disables it entirely.
# RATE_LIMIT_MAX_KEYS bounds the in-memory counters per limiter with
# least-recently-used eviction (default 10000).
# RATE_LIMIT_TRUSTED_PROXIES is a comma-separated list of IPs or CIDR ranges
# whose forwarded client-address headers are trusted. Leave empty (recommended
# unless you run a known reverse proxy) so the socket address is always used and
# a client cannot spoof its rate-limit key.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_KEYS=10000
# RATE_LIMIT_TRUSTED_PROXIES=

# Released version baked into the API image (docker-compose.yml build arg). The
# API reports it from GET /api/v1/version. Defaults to "dev" for local builds.
# RYZE_VERSION=2.98.0

# Platform administrators (configuration-only accounts, never stored in the
# database). Each admin needs a username, a password (at least 12 characters,
# the same minimum as user passwords) and an access code (the second
# authentication factor, at least 8 characters). Access codes are secrets: never
# commit real values and never expose them to the frontend. Missing or invalid
# values fail backend startup.
ADMIN_1_USERNAME=
ADMIN_1_PASSWORD=
ADMIN_1_ACCESS_CODE=
ADMIN_2_USERNAME=
ADMIN_2_PASSWORD=
ADMIN_2_ACCESS_CODE=

# Regular test user account (local development). The account is created
# through the public registration endpoint; login uses the email/password
# pair below. The password must satisfy the 12-128 character policy.
TEST_USER_EMAIL=teste1@gmail.com
TEST_USER_PASSWORD=RyzeTest1234

# Admin Test Mode (optional, default false). When enabled, the technical
# administrator can impersonate the two predefined personas (Test Client and
# Test Trainer) to exercise the customer commerce flows without real payments.
# Inside Test Mode every purchasable Generic Program is presented as Free and
# purchases are completed server-side without any payment provider.
# TEST_MODE_ENABLED=true

# Exercise catalogue media (optional, default disabled). The bundled dataset
# media is licensed from Gym visual and may not be delivered publicly until the
# commercial-use terms have been verified. While disabled, every exercise still
# lists and opens normally but media fields are empty and media_available is
# false, so clients render an explicit unavailable state. Enabling this only
# makes the API expose the stored media references; serving the files is a
# separate, deployment-level decision.
# EXERCISE_MEDIA_ENABLED=false
# Same-origin absolute path the API prefixes to the stored relative media
# references. Defaults to /media/exercises.
# EXERCISE_MEDIA_BASE_PATH=/media/exercises
#
# Local development only: `npm run dev` serves the downloaded dataset media to
# localhost at /dev-exercise-media (never bundled, never available in preview or
# production). To inspect media locally, set both values below in your local
# .env and restart the backend. This does NOT grant redistribution rights.
# EXERCISE_MEDIA_ENABLED=true
# EXERCISE_MEDIA_BASE_PATH=/dev-exercise-media

# Public contact form delivery (optional). The recipient is always server-owned.
# Delivery stays disabled unless CONTACT_SMTP_HOST, CONTACT_FROM and
# CONTACT_RECIPIENT are all set; a partial configuration fails startup. SMTP
# uses STARTTLS and, when credentials are set, refuses to authenticate over an
# unencrypted connection. With delivery disabled the endpoint stays mounted and
# answers 503 CONTACT_UNAVAILABLE instead of pretending to send.
# CONTACT_SMTP_HOST=smtp.example.com
# CONTACT_SMTP_PORT=587
# CONTACT_SMTP_USERNAME=
# CONTACT_SMTP_PASSWORD=
# CONTACT_FROM=RYZE <contact@example.com>
# CONTACT_RECIPIENT=RYZE Support <support@example.com>

# Trainer-application evidence store (optional). Uploaded verification documents
# are private files: they are never placed under a web root and are only served
# through the authenticated download endpoints. Defaults to
# storage/trainer-evidence relative to the backend working directory.
# TRAINER_EVIDENCE_DIR=storage/trainer-evidence
# Maximum size of one stored document in bytes. Defaults to 10485760 (10 MiB)
# and must not exceed 26214400 (25 MiB).
# TRAINER_EVIDENCE_MAX_BYTES=10485760

# Stripe Checkout provider (optional). Serves the "card" and "mbway" payment
# methods through Stripe-hosted Checkout Sessions. Card details and the MB WAY
# phone number are entered on the Stripe page only: RYZE never receives, logs or
# stores them.
#
# Stripe is enabled ONLY when BOTH STRIPE_SECRET_KEY and
# STRIPE_WEBHOOK_SECRET are set — webhooks are required to confirm a payment, so
# a secret key without a signing secret leaves both "card" and "mbway"
# unadvertised. Leave all values empty to keep Stripe payments disabled.
#
# MB WAY has no extra variable here: it shares this Stripe configuration. It
# additionally needs the "mb_way_payments" capability enabled on the Stripe
# account (Dashboard -> Settings -> Payment methods), which RYZE cannot read.
# Stripe settles MB WAY only in EUR and between 0.50 EUR and 5,000 EUR; RYZE
# enforces that window from the purchase snapshot before calling Stripe.
#
# STRIPE_SUCCESS_URL / STRIPE_CANCEL_URL support the {program_id} and
# {purchase_id} placeholders, substituted server-side per session. The success
# URL must also keep the {CHECKOUT_SESSION_ID} placeholder so the return leg can
# be verified server-side, e.g.
#   https://app.example/en/services/generic-program/{program_id}/purchase/success?session_id={CHECKOUT_SESSION_ID}&purchase_id={purchase_id}
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# PayPal provider (optional). When PAYPAL_CLIENT_ID is set the payment provider
# uses PayPal Orders instead of the placeholder. Mode must be "sandbox" or
# "live". Leave all values empty to keep PayPal payments disabled.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# Webhook verification secrets (optional). Leave empty to disable the
# corresponding webhook endpoint. Only verified provider events may complete a
# purchase — browser redirects are never trusted. An empty Stripe signing secret
# also disables the card and MB WAY payment methods entirely.
# STRIPE_WEBHOOK_SECRET: Stripe webhook signing secret from the Stripe dashboard.
# PAYPAL_WEBHOOK_ID: PayPal webhook ID from the PayPal dashboard.
STRIPE_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_ID=
